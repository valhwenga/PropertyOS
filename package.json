{
  "name": "spike-propertyos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.11.0 <23" },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @propertyos/web build",
    "preview": "./scripts/preview.sh",
    "preview:reset": "./scripts/preview.sh --reset",
    "preview:check": "pnpm --filter @propertyos/tests exec playwright test -c playwright.config.ts --project=desktop preview-smoke",
    "dev": "pnpm --filter @propertyos/web dev",
    "worker": "pnpm --filter @propertyos/worker dev",
    "db:migrate": "pnpm --filter @propertyos/db migrate",
    "db:reset": "pnpm --filter @propertyos/db reset",
    "db:seed": "pnpm --filter @propertyos/db seed",
    "db:mfa": "pnpm --filter @propertyos/db exec tsx src/cli/mfa.ts",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "pnpm --filter @propertyos/tests e2e",
    "typecheck": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @propertyos/worker build && pnpm --filter @propertyos/web typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
