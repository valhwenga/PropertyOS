# Regenerated by Next on every dev/build, and it differs between the two:
# `next dev` points it at .next/dev/types, `next build` at .next/types. Tracking
# it means the working tree is dirty after whichever one you ran last. Next
# writes it automatically, and `tsc --noEmit` passes without it.
apps/web/next-env.d.ts
