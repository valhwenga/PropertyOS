# ---------------------------------------------------------------------------
# Spike PropertyOS — environment configuration
# This file contains NO secrets. Copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Privileged/owner connection. Used ONLY by migrations and by the worker's job
# claiming loop. Never serves a web request.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/propertyos_dev

# Application connection. MUST be a login role that is a member of
# `propertyos_app` and that is neither a superuser nor carries BYPASSRLS.
# The app refuses to start if this role can bypass Row Level Security.
APP_DATABASE_URL=postgresql://propertyos_app_login:change-me@127.0.0.1:5432/propertyos_dev

# --- Authentication ---------------------------------------------------------
# AUTH_PROVIDER=supabase  -> production: Supabase Auth owns credentials and MFA.
# AUTH_PROVIDER=local     -> development only: credentials stored in auth.users.
AUTH_PROVIDER=local

# 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Seals full identity and bank account numbers at rest, so a lease agreement can
# state them. 32 bytes, base64: openssl rand -base64 32
# Without it those fields cannot be stored or read, and a generated agreement
# will report them as incomplete rather than inventing anything.
FIELD_ENCRYPTION_KEY=

# --- Supabase (required when AUTH_PROVIDER=supabase) ------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser; it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=propertyos-private

# --- Email ------------------------------------------------------------------
# EMAIL_PROVIDER=smtp -> real delivery. Anything else, or missing credentials,
# uses the development sink, which records messages as 'development_sink' and
# NEVER reports them as delivered.
#
# Port 465 uses implicit TLS; any other port attempts STARTTLS. A message is
# only ever recorded as 'sent' when the server issued a 2xx to the final DATA
# terminator, i.e. when it accepted responsibility for the message.
EMAIL_PROVIDER=sink
EMAIL_FROM="PropertyOS <no-reply@example.test>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Development only. Never set this in production.
SMTP_ALLOW_SELF_SIGNED=false

# --- Malware scanning -------------------------------------------------------
# MALWARE_SCANNER=clamav streams uploads to clamd over the INSTREAM protocol.
# Unset means uploads are quarantined and recorded as 'skipped_not_configured'.
# No file is ever reported as scanned when no scanner is configured, and a scan
# that fails or times out is NEVER treated as clean.
MALWARE_SCANNER=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# --- Document storage -------------------------------------------------------
# With NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY set, objects live
# in a PRIVATE Supabase bucket and downloads use Supabase signed URLs.
# Otherwise objects live on local disk under LOCAL_STORAGE_ROOT and downloads
# use HMAC-signed, expiring links redeemed by the application itself.
# In both cases the permission check happens BEFORE any URL is minted.
LOCAL_STORAGE_ROOT=.storage

# --- Worker -----------------------------------------------------------------
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=5

# --- Application ------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
DEFAULT_COUNTRY=ZA
DEFAULT_CURRENCY=ZAR
DEFAULT_TIME_ZONE=Africa/Johannesburg

# --- Rent payment provider (DISABLED until merchant ownership is confirmed) --
# Do not set these until the merchant account owner, settlement destination and
# funds custody arrangement are confirmed in writing. See docs/decisions/0004.
RENT_PAYMENT_PROVIDER_ENABLED=false
