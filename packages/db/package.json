{
  "name": "@propertyos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/privileged.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli/migrate.ts",
    "reset": "tsx src/cli/migrate.ts --reset",
    "seed": "tsx src/cli/seed.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
